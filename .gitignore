# LaTeX auxiliary / compiled output
*.aux
*.log
*.out
*.bbl
*.blg
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)

# Compiled manuscript PDF (keep figures/, which are inputs)
*.pdf
!figures/*.pdf
# Orcidlogo-mark.pdf is an input, not compiled output: sn-jnl.cls needs it.
!Orcidlogo-mark.pdf

# The generated bibliography IS tracked: it is part of the submission package and
# lets manuscript.pdf be rebuilt with pdflatex alone (no bibtex run).
!manuscript.bbl

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Local archive of the previous MMTB submission (not part of the JES repo)
_archive_mmtb/

# Local JES transfer planning notes (not part of the repo)
jes-transfer-plan/

# Local review workspace: agent review reports, compile logs, rendered page PNGs, rerun outputs
review_workspace/

# TRAE tooling
.trae-html-share-packages/
.uploads/

# Tool-generated index/copies (see manuscript_v1.tex == manuscript.tex)
_index/
manuscript_v1.tex

# Generated submission package (rebuilt from manuscript.tex)
submission_jsm/

# Downloaded Springer Nature template sources (third-party; the files actually
# used, sn-jnl.cls and the two .bst, are vendored at the repository root)
_snjnl/

# PNG previews written by the figure scripts (regenerable; the EPS/PDF is the artefact)
figures_eps/*.png
